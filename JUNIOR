  var SHEET_ENDPOINT = '';

  var app = document.getElementById('app');

  function h(tag, attrs) {
    var el = document.createElement(tag);
    attrs = attrs || {};
    for (var k in attrs) {
      if (attrs[k] == null) continue;
      if (k === 'class') el.className = attrs[k];
      else if (k.indexOf('on') === 0) el[k] = attrs[k];
      else if (k === 'value') el.value = attrs[k];
      else if (k === 'disabled') { if (attrs[k]) el.setAttribute('disabled', 'disabled'); }
      else el.setAttribute(k, attrs[k]);
    }
    function appendKid(kid) {
      if (kid === null || kid === undefined || kid === false) return;
      el.appendChild(kid.nodeType ? kid : document.createTextNode(String(kid)));
    }
    for (var i = 2; i < arguments.length; i++) {
      var child = arguments[i];
      if (child == null) continue;
      if (Array.isArray(child)) { child.forEach(appendKid); } else { appendKid(child); }
    }
    return el;
  }
  function norm(x) { return (x || '').trim(); }
  function clueFromPassage(text, target) {
    var i = text.indexOf(target);
    if (i < 0) return { pre: '', target: target, post: text };
    return { pre: text.slice(0, i), target: target, post: text.slice(i + target.length) };
  }
  function passageBox(passage, target) {
    var clue = clueFromPassage(passage.text, target);
    return h('div', { class: 'passagebox' },
      h('div', { class: 'passagehead' },
        h('span', { class: 'passagetitle' }, passage.title),
        h('span', { class: 'passagegenre' }, passage.genre)),
      h('p', { class: 'passagetext' }, clue.pre, h('span', { class: 'wordfocus' }, clue.target), clue.post));
  }
  function sentenceBox(text, target) {
    var clue = clueFromPassage(text, target || '');
    return h('div', { class: 'passagebox' },
      h('p', { class: 'passagetext' }, clue.pre, h('span', { class: 'wordfocus' }, clue.target), clue.post));
  }

  /* ---------- sound (Web Audio API — no files, no copyright) ---------- */
  var ACtx = window.AudioContext || window.webkitAudioContext;
  var actx = null;
  function beep(freqs, dur, type) {
    try {
      if (!ACtx) return;
      if (!actx) actx = new ACtx();
      var t = actx.currentTime;
      freqs.forEach(function (f, i) {
        var osc = actx.createOscillator(), gain = actx.createGain();
        osc.type = type || 'sine';
        osc.frequency.value = f;
        osc.connect(gain); gain.connect(actx.destination);
        var start = t + i * dur;
        gain.gain.setValueAtTime(0.0001, start);
        gain.gain.exponentialRampToValueAtTime(0.18, start + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, start + dur);
        osc.start(start); osc.stop(start + dur + 0.02);
      });
    } catch (e) { /* ignore */ }
  }
  function playCorrect() { beep([523.25, 659.25, 783.99], 0.14, 'sine'); }
  function playWrong() { beep([220, 160], 0.18, 'sawtooth'); }

  var OK_MEMES = [
    { emoji: '🎉🧠', text: 'BRAIN GENIUS!' },
    { emoji: '🚀😎', text: 'NAILED IT!' },
    { emoji: '🏆🔥', text: 'ON FIRE!' },
    { emoji: '⭐🙌', text: 'WORD WIZARD!' },
    { emoji: '💪😁', text: 'EASY PEASY!' }
  ];
  var BAD_MEMES = [
    { emoji: '😅💭', text: 'OOF, so close!' },
    { emoji: '🙈😬', text: 'NOT QUITE!' },
    { emoji: '🤔❓', text: 'HMM, TRY AGAIN!' },
    { emoji: '😵‍💫🫣', text: 'BRAIN FREEZE!' }
  ];
  function pickMeme(ok) {
    var pool = ok ? OK_MEMES : BAD_MEMES;
    return pool[Math.floor(Math.random() * pool.length)];
  }
  function memeCard(ok) {
    var m = pickMeme(ok);
    return h('div', { class: 'memewrap' },
      h('div', { class: 'memeemoji' }, m.emoji),
      h('div', { class: 'memetext ' + (ok ? 'ok' : 'bad') }, m.text));
  }

  var S = { phase: 'home' };
  function goHome() { S.phase = 'home'; render(); }

  function masthead() {
    return h('header', { class: 'mast' },
      h('div', { class: 'masttext' },
        h('p', { class: 'eyebrow' }, 'C-Suite Kids · Junior'),
        h('h1', null, 'Funky ', h('span', { class: 'lens' }, 'Learning'))),
      h('img', { class: 'cskmark', src: 'data:image/jpeg;base64,', alt: 'C-Suite Kids logo' }));
  }
  function cskFooter() {
    return h('div', { class: 'csk-foot' },
      h('div', { class: 'brand' }, 'C-Suite Kids (CSK) · Training Future Leaders'),
      h('div', null, 'Fun word games for Year 1–6 readers.'),
      h('div', null, 'www.c-suite-kids.com · WhatsApp +6 017 392 9915'));
  }

  function viewHome() {
    return [
      masthead(),
      h('p', { class: 'lede' }, 'Pick a level to play!'),
      h('section', { class: 'card' },
        h('div', { class: 'levelpick' },
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start1'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 1'),
            h('span', { class: 'leveltitle' }, 'Opposites & Matches'),
            h('span', { class: 'leveldesc' }, 'Antonyms & synonyms — 20 questions, with a fun reaction every time!')),
          h('button', { class: 'levelcard bonus', type: 'button', onclick: function () { S.phase = 'startiv1'; render(); } },
            h('span', { class: 'levelnum' }, 'Bonus'),
            h('span', { class: 'leveltitle' }, 'Fact or Bluff? #1'),
            h('span', { class: 'leveldesc' }, '6 crazy facts — guess which ones are true!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start2'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 2'),
            h('span', { class: 'leveltitle' }, 'Word Detective Junior'),
            h('span', { class: 'leveldesc' }, 'Antonyms & synonyms inside short stories — 20 questions, with sound!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start3'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 3'),
            h('span', { class: 'leveltitle' }, 'Punctuation Power'),
            h('span', { class: 'leveldesc' }, 'Name each punctuation mark and say what it does — 20 questions!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start4'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 4'),
            h('span', { class: 'leveltitle' }, 'Punctuation Fix-It'),
            h('span', { class: 'leveldesc' }, 'Spot the punctuation mistake, then pick the fix — 20 questions!')),
          h('button', { class: 'levelcard bonus', type: 'button', onclick: function () { S.phase = 'startiv2'; render(); } },
            h('span', { class: 'levelnum' }, 'Bonus'),
            h('span', { class: 'leveltitle' }, 'Fact or Bluff? #2'),
            h('span', { class: 'leveldesc' }, '6 crazy facts — guess which ones are true!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start5'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 5'),
            h('span', { class: 'leveltitle' }, 'Mix-Up Words'),
            h('span', { class: 'leveldesc' }, 'Tricky word pairs like advice/advise and its/it’s — 30 questions!')),
          h('button', { class: 'levelcard bonus', type: 'button', onclick: function () { S.phase = 'startiv3'; render(); } },
            h('span', { class: 'levelnum' }, 'Bonus'),
            h('span', { class: 'leveltitle' }, 'Fact or Bluff? #3'),
            h('span', { class: 'leveldesc' }, '6 crazy facts — guess which ones are true!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start6'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 6'),
            h('span', { class: 'leveltitle' }, 'Word Form Fill-In'),
            h('span', { class: 'leveldesc' }, 'Pick the word that correctly fits each sentence — 20 questions!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start7'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 7'),
            h('span', { class: 'leveltitle' }, 'Read Between the Lines'),
            h('span', { class: 'leveldesc' }, '6 stories & facts, inference + opinion questions — 48 questions!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start8'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 8'),
            h('span', { class: 'leveltitle' }, 'Spot the Figurative Language'),
            h('span', { class: 'leveldesc' }, 'Find the figurative phrase in each sentence — 20 questions!')),
          h('button', { class: 'levelcard bonus', type: 'button', onclick: function () { S.phase = 'startiv4'; render(); } },
            h('span', { class: 'levelnum' }, 'Bonus'),
            h('span', { class: 'leveltitle' }, 'Fact or Bluff? #4'),
            h('span', { class: 'leveldesc' }, '6 crazy tech facts — guess which ones are true!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start9'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 9'),
            h('span', { class: 'leveltitle' }, 'Finish the Figurative Sentence'),
            h('span', { class: 'leveldesc' }, 'Pick the ending that completes the sentence figuratively — 20 questions!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start10'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 10'),
            h('span', { class: 'leveltitle' }, 'What Type of Writing Is This?'),
            h('span', { class: 'leveldesc' }, '10 passages, 10 writing types — narrative, descriptive & more, 20 questions!')),
          h('button', { class: 'levelcard bonus', type: 'button', onclick: function () { S.phase = 'startiv5'; render(); } },
            h('span', { class: 'levelnum' }, 'Bonus'),
            h('span', { class: 'leveltitle' }, 'Letters to My Future Self'),
            h('span', { class: 'leveldesc' }, 'Write 2 short letters — about your studies and your future work!')),
          h('button', { class: 'levelcard', type: 'button', onclick: function () { S.phase = 'start11'; render(); } },
            h('span', { class: 'levelnum' }, 'Level 11'),
            h('span', { class: 'leveltitle' }, 'Speech, Article, Email or Letter?'),
            h('span', { class: 'leveldesc' }, 'Speech, article, conversation, email & letters — 10 questions!')))),
      cskFooter()
    ];
  }

  /* ======================================================================
   * LEVEL 1 — Opposites & Matches (antonyms / synonyms, 20 Qs, memes)
   * ==================================================================== */
  var QUESTIONS1 = [
    { word: 'HAPPY', type: 'Synonym', options: ['Glad', 'Sad', 'Angry', 'Tired'], correct: 0, explain: '"Glad" means the same as "happy" — a synonym.' },
    { word: 'BIG', type: 'Antonym', options: ['Small', 'Huge', 'Large', 'Tall'], correct: 0, explain: '"Small" is the opposite of "big" — an antonym.' },
    { word: 'FAST', type: 'Synonym', options: ['Quick', 'Slow', 'Loud', 'Short'], correct: 0, explain: '"Quick" means the same as "fast" — a synonym.' },
    { word: 'HOT', type: 'Antonym', options: ['Cold', 'Warm', 'Sunny', 'Wet'], correct: 0, explain: '"Cold" is the opposite of "hot" — an antonym.' },
    { word: 'SMALL', type: 'Synonym', options: ['Tiny', 'Giant', 'Wide', 'Heavy'], correct: 0, explain: '"Tiny" means the same as "small" — a synonym.' },
    { word: 'LOUD', type: 'Antonym', options: ['Quiet', 'Noisy', 'Fast', 'Bright'], correct: 0, explain: '"Quiet" is the opposite of "loud" — an antonym.' },
    { word: 'SCARED', type: 'Synonym', options: ['Afraid', 'Brave', 'Calm', 'Proud'], correct: 0, explain: '"Afraid" means the same as "scared" — a synonym.' },
    { word: 'CLEAN', type: 'Antonym', options: ['Dirty', 'Shiny', 'Neat', 'Fresh'], correct: 0, explain: '"Dirty" is the opposite of "clean" — an antonym.' },
    { word: 'BEGIN', type: 'Synonym', options: ['Start', 'Finish', 'Pause', 'Continue'], correct: 0, explain: '"Start" means the same as "begin" — a synonym.' },
    { word: 'EASY', type: 'Antonym', options: ['Difficult', 'Simple', 'Quick', 'Light'], correct: 0, explain: '"Difficult" is the opposite of "easy" — an antonym.' },
    { word: 'FULL', type: 'Antonym', options: ['Empty', 'Heavy', 'Round', 'Tight'], correct: 0, explain: '"Empty" is the opposite of "full" — an antonym.' },
