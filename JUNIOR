<style>
:root {
  --bg1: #FFE9A8;
  --bg2: #FFC6E0;
  --surface: #FFFFFF;
  --ink: #2A1E3D;
  --muted: #7B6E92;
  --line: #F1DDF2;
  --accent: #FF5E8A;
  --accent-ink: #FFFFFF;
  --accent-soft: #FFE1EA;
  --purple: #6A3FBF;
  --purple-soft: #ECE3FB;
  --blue: #2E8FD6;
  --blue-soft: #DEF0FD;
  --gold: #E8A400;
  --gold-soft: #FFF3D1;
  --miss: #E0453F;
  --miss-soft: #FDE6E4;
  --ok: #1FA362;
  --ok-soft: #DEF6E9;
  --display: "Baloo 2", "Trebuchet MS", system-ui, sans-serif;
  --body: "Nunito Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --fun: "Mochiy Pop One", var(--display);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg1: #241B36; --bg2: #3A2347; --surface: #2B2140; --ink: #F3ECFB; --muted: #C7B9E0;
    --line: #4A3A63; --accent: #FF8FAE; --accent-ink: #2B0D16; --accent-soft: #452434;
    --purple: #C3A9FA; --purple-soft: #3A2E54; --blue: #8FC6F0; --blue-soft: #263655;
    --gold: #FFD166; --gold-soft: #453418; --miss: #FF8A80; --miss-soft: #3D1F27;
    --ok: #7EE8B0; --ok-soft: #153A2B;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; min-height: 100vh; font-family: var(--body); color: var(--ink);
  background: linear-gradient(160deg, var(--bg1), var(--bg2));
  display: flex; justify-content: center; padding: 24px 16px 60px;
}
#app { max-width: 640px; width: 100%; display: flex; flex-direction: column; gap: 18px; }
.mast { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.masttext .eyebrow { font-family: var(--mono, var(--body)); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--purple); margin: 0 0 2px; font-weight: 800; }
.masttext h1 { font-family: var(--fun); font-size: 1.7rem; margin: 0; color: var(--ink); }
.masttext h1 .lens { color: var(--accent); }
.cskmark { width: 48px; height: 48px; border-radius: 12px; object-fit: cover; }
.card { background: var(--surface); border-radius: 22px; padding: 22px; box-shadow: 0 10px 30px rgba(80,40,120,0.15); }
.lede { font-size: 1rem; color: var(--purple); font-weight: 700; margin: 0; }
.levelpick { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
@media (max-width: 480px) { .levelpick { grid-template-columns: 1fr; } }
.levelcard { text-align: left; border: 2px solid var(--line); border-radius: 18px; padding: 16px; background: var(--surface); cursor: pointer; display: flex; flex-direction: column; gap: 4px; font-family: var(--body); }
.levelcard:hover { border-color: var(--accent); transform: translateY(-2px); }
.levelcard .levelnum { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); font-weight: 800; }
.levelcard .leveltitle { font-family: var(--display); font-weight: 800; font-size: 1.15rem; color: var(--purple); }
.levelcard .leveldesc { font-size: 13px; color: var(--muted); }
.levelcard.bonus { border-style: dashed; border-color: var(--purple); background: linear-gradient(135deg, var(--bg1), var(--bg2)); }
.levelcard.bonus .levelnum { color: var(--purple); }
.rules { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.rule { background: var(--purple-soft); border-radius: 14px; padding: 10px 14px; display: flex; flex-direction: column; align-items: center; min-width: 76px; }
.rule b { font-family: var(--display); font-size: 1.1rem; color: var(--purple); }
.rule span { font-size: 11px; color: var(--muted); text-align: center; }
.note { font-size: 13px; color: var(--muted); }
.field { margin-top: 12px; }
.field label { display: block; font-size: 13px; font-weight: 700; color: var(--purple); margin-bottom: 4px; }
.field input { width: 100%; padding: 12px 14px; border-radius: 14px; border: 2px solid var(--line); font-size: 15px; font-family: var(--body); background: var(--bg, #fff); color: var(--ink); }
.field input:focus { outline: none; border-color: var(--accent); }
textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border: 2px solid var(--line); font-size: 15px; font-family: var(--body); background: var(--bg, #fff); color: var(--ink); resize: vertical; margin-top: 8px; }
textarea:focus { outline: none; border-color: var(--accent); }
.wordcount { font-size: 12px; color: var(--muted); margin-top: 6px; text-align: right; }
.notice.miss { color: var(--miss); font-size: 12px; margin-top: 4px; }
.row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.btn { font-family: var(--display); font-weight: 700; font-size: 15px; padding: 13px 22px; border-radius: 16px; border: none; background: var(--accent); color: var(--accent-ink); cursor: pointer; }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.btn.ghost { background: transparent; color: var(--purple); border: 2px solid var(--line); }
.bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.pips { display: flex; gap: 4px; flex-wrap: wrap; }
.pip { width: 20px; height: 20px; border-radius: 6px; background: var(--line); color: var(--muted); font-size: 10px; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.pip.p3 { background: var(--ok); color: #fff; }
.pip.p0 { background: var(--miss); color: #fff; }
.pip.now { outline: 2px solid var(--accent); }
.score { font-family: var(--display); font-weight: 800; color: var(--purple); background: var(--purple-soft); padding: 6px 12px; border-radius: 12px; white-space: nowrap; }
.case { position: relative; }
.tab { display: inline-block; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); background: var(--blue-soft); padding: 4px 10px; border-radius: 10px; font-weight: 800; margin-bottom: 10px; }
.wordcard { font-family: var(--display); font-size: 2rem; text-align: center; color: var(--purple); background: var(--purple-soft); border-radius: 16px; padding: 22px 10px; margin: 10px 0 4px; letter-spacing: 0.02em; }
.wordtype { text-align: center; font-size: 13px; font-weight: 800; color: var(--accent); text-transform: uppercase; margin-bottom: 14px; }
.passagebox { background: var(--gold-soft); border-radius: 16px; padding: 16px; margin: 10px 0 14px; }
.passagehead { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
.passagetitle { font-family: var(--display); font-weight: 800; color: var(--purple); }
.passagegenre { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.passagetext { margin: 0; line-height: 1.55; font-size: 15px; }
.passagetext .wordfocus { background: var(--accent); color: #fff; padding: 2px 4px; border-radius: 6px; font-weight: 700; }
.part { margin: 10px 0; }
.partlabel { font-weight: 800; color: var(--purple); margin-bottom: 10px; font-family: var(--display); }
.choices { display: flex; flex-direction: column; gap: 10px; }
.choices.cols2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
@media (max-width: 480px) { .choices.cols2 { grid-template-columns: 1fr; } }
.choice { text-align: left; border: 2px solid var(--line); border-radius: 14px; padding: 12px 16px; background: var(--surface); font-size: 15px; font-family: var(--body); color: var(--ink); cursor: pointer; }
.choice.picked { border-color: var(--accent); background: var(--accent-soft); font-weight: 700; }
.verdict { margin-top: 14px; }
.explainbox { background: var(--blue-soft); border-radius: 14px; padding: 12px 14px; font-size: 14px; margin-top: 10px; }
.answerline { font-weight: 700; color: var(--purple); font-size: 14px; }
.memewrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 0 4px; animation: pop 0.35s ease; }
.memeemoji { font-size: 4.2rem; line-height: 1; }
.memetext { font-family: var(--fun); font-size: 1.1rem; margin-top: 6px; text-align: center; }
.memetext.ok { color: var(--ok); }
.memetext.bad { color: var(--miss); }
@keyframes pop { 0% { transform: scale(0.4) rotate(-6deg); opacity: 0; } 60% { transform: scale(1.1) rotate(3deg); opacity: 1; } 100% { transform: scale(1) rotate(0); } }
.final .stamp { display: inline-block; font-family: var(--display); font-weight: 800; padding: 6px 14px; border-radius: 12px; }
.stamp.p3 { background: var(--ok-soft); color: var(--ok); }
.stamp.p0 { background: var(--miss-soft); color: var(--miss); }
.rank { font-family: var(--fun); font-size: 1.6rem; color: var(--purple); margin: 10px 0 2px; }
.bigscore { font-weight: 800; color: var(--accent); margin: 0; }
.rankline { color: var(--muted); margin: 2px 0 10px; }
.statgrid { display: flex; gap: 10px; flex-wrap: wrap; }
.stat { background: var(--blue-soft); border-radius: 14px; padding: 10px 14px; display: flex; flex-direction: column; align-items: center; min-width: 80px; }
.stat b { font-family: var(--display); color: var(--blue); }
.stat span { font-size: 11px; color: var(--muted); }
.syncline { font-size: 12px; color: var(--muted); margin-top: 10px; }
.syncline.ok { color: var(--ok); }
.syncline.failed { color: var(--miss); }
.csk-foot { text-align: center; font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.6; }
.csk-foot .brand { font-weight: 800; color: var(--purple); }
</style>
<div id="app"></div>
<script>
(function () {
  /* ======================================================================
   * CONFIG — paste a Google Apps Script "Web app" URL here once deployed
